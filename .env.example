NEXT_PUBLIC_SITE_URL=https://www.thecosmictalks.com
NEXT_PUBLIC_BRAND_NAME=CosmicTalks
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_PHONE_NUMBER=+919876543210
NEXT_PUBLIC_CONTACT_EMAIL=hello@thecosmictalks.com

# Until thecosmictalks.com DNS is live, set NEXT_PUBLIC_SITE_URL on Vercel to
# the host that actually serves the app so canonical/OG URLs stay correct.
# NEXT_PUBLIC_BRAND_NAME must also be set in the Vercel dashboard (CosmicTalks)
# or a leftover CosmicGyan env value will override this file after deploy.

# AI Astro Chat / live horoscope
# Prefer: AI_PROVIDER=gemini | openai
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# Optional: HMAC secret for free-chat cookie quota (defaults to AI key)
# CHAT_QUOTA_SECRET=long-random-string

# Neon Postgres (Vercel Storage) — pulled via `vercel env pull` after
# `vercel install neon`. Required for /api/places/search and future app tables.
# DATABASE_URL=
# POSTGRES_URL=
# DATABASE_URL_UNPOOLED=

# Shared secret for /api/cron/db-keepalive (GitHub Actions keep-alive).
# Also set as GitHub Actions secret CRON_SECRET (and optional KEEPALIVE_URL).
# CRON_SECRET=

# Vault wrapping key (KEK only — NOT a vendor API key).
# All OpenAI / Razorpay / SMTP / SMS / Auth0 secrets are entered in Super Admin
# and stored encrypted in Postgres. Required on Vercel. Locally, a key is
# auto-created at .vault/wrap.key (gitignored).
#
# BACKUP (required before production keys):
# 1. Super Admin → Flags → Download encrypted KEK backup (passphrase-wrapped).
# 2. Store the JSON file + passphrase offline (1Password / printed / USB).
#    Never only in Vercel. If SECRETS_WRAP_KEY is deleted, restore from that file:
#    set SECRETS_WRAP_KEY to the restored key, then restart.
# 3. Also paste the same wrap key into Vercel env SECRETS_WRAP_KEY.
# SECRETS_WRAP_KEY=
