NEXT_PUBLIC_SITE_URL=https://www.cosmicgpt.in
NEXT_PUBLIC_BRAND_NAME=CosmicGPT
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_PHONE_NUMBER=+919876543210
NEXT_PUBLIC_CONTACT_EMAIL=hello@cosmicgpt.in

# AI Astro Chat / live horoscope
# Prefer: AI_PROVIDER=gemini | openai
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# Optional: HMAC secret for free-chat cookie quota (defaults to AI key)
# CHAT_QUOTA_SECRET=long-random-string

# Neon Postgres (Vercel Storage) — pulled via `vercel env pull` after
# `vercel install neon`. Required for /api/places/search and future app tables.
# DATABASE_URL=
# POSTGRES_URL=
# DATABASE_URL_UNPOOLED=

# Shared secret for /api/cron/db-keepalive (GitHub Actions keep-alive).
# Also set as GitHub Actions secret CRON_SECRET (and optional KEEPALIVE_URL).
# CRON_SECRET=

# Optional override for keep-alive target (defaults to production).
# KEEPALIVE_URL=https://www.astrologics.co/api/cron/db-keepalive
