# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# GeoNames raw / uncompressed dumps (gzipped source + prebuilt index are tracked/built)
/data/geonames/IN.txt
/data/geonames/india_places.json
/data/geonames/india_places.jsonl
/data/geonames/.bench-index/
/data/geonames/admin1CodesASCII.txt

# typescript
*.tsbuildinfo
next-env.d.ts
*.tmp

# local galaxy preview artifacts (not for production)
/public/tmp-galaxy-preview/
/public/tmp-home-galaxy/
/public/tmp-galaxy-motion-preview.html

# local agent / IDE scratch (not for production)
/.agents/
/.cursor/
/skills-lock.json
/archive/
/scripts/fixtures/cross-validation/last-report.json
